<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_axsync_mcp_mask_list" model="ir.ui.view">
        <field name="name">axsync.mcp.mask.list</field>
        <field name="model">axsync.mcp.mask</field>
        <field name="arch" type="xml">
            <list string="Field masks" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="model_id"/>
                <field name="field_name"/>
                <field name="mode"/>
                <field name="exempt_group_ids" widget="many2many_tags"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>
    <record id="action_axsync_mcp_mask" model="ir.actions.act_window">
        <field name="name">Field masks</field>
        <field name="res_model">axsync.mcp.mask</field>
        <field name="view_mode">list</field>
    </record>
</odoo>
