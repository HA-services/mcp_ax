<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_axsync_mcp_profile_list" model="ir.ui.view">
        <field name="name">axsync.mcp.profile.list</field>
        <field name="model">axsync.mcp.profile</field>
        <field name="arch" type="xml">
            <tree string="Access levels">
                <field name="name"/>
                <field name="level"/>
                <field name="enforced"/>
                <field name="description"/>
            </tree>
        </field>
    </record>
    <record id="view_axsync_mcp_profile_form" model="ir.ui.view">
        <field name="name">axsync.mcp.profile.form</field>
        <field name="model">axsync.mcp.profile</field>
        <field name="arch" type="xml">
            <form string="Access level">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="level"/>
                            <field name="active" invisible="1"/>
                        </group>
                        <group>
                            <field name="enforced"/>
                        </group>
                    </group>
                    <group><field name="description"/></group>
                    <notebook>
                        <page string="Allowed models" invisible="level != 'custom'">
                            <field name="line_ids">
                                <tree editable="bottom">
                                    <field name="model_id"/>
                                    <field name="can_read"/>
                                    <field name="can_create"/>
                                    <field name="can_write"/>
                                    <field name="can_unlink"/>
                                    <field name="can_call"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Allowed tools">
                            <field name="tool_ids" widget="many2many_tags"/>
                        </page>
                        <page string="Always applies to" invisible="not enforced">
                            <group>
                                <field name="user_ids" widget="many2many_tags"/>
                                <field name="group_ids" widget="many2many_tags"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_axsync_mcp_profile" model="ir.actions.act_window">
        <field name="name">Access levels</field>
        <field name="res_model">axsync.mcp.profile</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
