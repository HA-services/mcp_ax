<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_axsync_mcp_token_list" model="ir.ui.view">
        <field name="name">axsync.mcp.token.list</field>
        <field name="model">axsync.mcp.token</field>
        <field name="arch" type="xml">
            <list string="Tokens" create="false" decoration-muted="state != 'active'">
                <field name="name"/>
                <field name="user_id"/>
                <field name="kind"/>
                <field name="prefix"/>
                <field name="profile_id"/>
                <field name="expires_on"/>
                <field name="last_used"/>
                <field name="use_count"/>
                <field name="state" widget="badge" decoration-success="state == 'active'" decoration-warning="state == 'expired'" decoration-danger="state == 'revoked'"/>
            </list>
        </field>
    </record>
    <record id="view_axsync_mcp_token_form" model="ir.ui.view">
        <field name="name">axsync.mcp.token.form</field>
        <field name="model">axsync.mcp.token</field>
        <field name="arch" type="xml">
            <form string="Token" create="false" edit="false">
                <header>
                    <button name="action_revoke" type="object" string="Revoke" invisible="state == 'revoked'"
                            confirm="Revoke this token? The connected application loses access immediately."/>
                    <field name="state" widget="statusbar" statusbar_visible="active,expired,revoked"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="user_id"/>
                            <field name="kind"/>
                            <field name="prefix"/>
                            <field name="profile_id"/>
                            <field name="client_id" invisible="kind != 'oauth'"/>
                        </group>
                        <group>
                            <field name="expires_on"/>
                            <field name="last_used"/>
                            <field name="last_ip"/>
                            <field name="use_count"/>
                            <field name="revoked_on" invisible="state != 'revoked'"/>
                        </group>
                    </group>
                    <group string="Allowed IPs"><field name="ip_allowlist" nolabel="1"/></group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_axsync_mcp_token_search" model="ir.ui.view">
        <field name="name">axsync.mcp.token.search</field>
        <field name="model">axsync.mcp.token</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="user_id"/>
                <filter name="active_tokens" string="Active" domain="[('state', '=', 'active')]"/>
                <filter name="oauth" string="OAuth connections" domain="[('kind', '=', 'oauth')]"/>
                <filter name="inactive" string="Revoked" domain="[('active', '=', False)]"/>
                <group string="Group by">
                    <filter name="by_user" string="User" context="{'group_by': 'user_id'}"/>
                    <filter name="by_kind" string="Type" context="{'group_by': 'kind'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="action_axsync_mcp_token" model="ir.actions.act_window">
        <field name="name">Tokens</field>
        <field name="res_model">axsync.mcp.token</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_active_tokens': 1}</field>
    </record>

    <record id="view_axsync_mcp_token_wizard_form" model="ir.ui.view">
        <field name="name">axsync.mcp.token.wizard.form</field>
        <field name="model">axsync.mcp.token.wizard</field>
        <field name="arch" type="xml">
            <form string="Create token">
                <field name="state" invisible="1"/>
                <group invisible="state == 'done'">
                    <field name="name"/>
                    <field name="user_id" groups="axsync_mcp_server.group_axsync_mcp_manager"/>
                    <field name="profile_id"/>
                    <field name="days"/>
                    <field name="ip_allowlist" placeholder="One address or CIDR range per line. Empty allows any address."/>
                </group>
                <div invisible="state != 'done'">
                    <div class="alert alert-warning" role="alert">
                        Copy the token now. It is stored only as a hash and cannot be shown again.
                    </div>
                    <group>
                        <field name="endpoint" widget="CopyClipboardChar"/>
                        <field name="secret" widget="CopyClipboardChar"/>
                    </group>
                    <field name="snippets" widget="text"/>
                </div>
                <footer>
                    <button name="action_generate" type="object" string="Create token" class="btn-primary" invisible="state == 'done'"/>
                    <button string="Close" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="action_axsync_mcp_token_wizard" model="ir.actions.act_window">
        <field name="name">Create token</field>
        <field name="res_model">axsync.mcp.token.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <record id="view_axsync_mcp_client_list" model="ir.ui.view">
        <field name="name">axsync.mcp.client.list</field>
        <field name="model">axsync.mcp.client</field>
        <field name="arch" type="xml">
            <list string="OAuth clients" create="false">
                <field name="name"/>
                <field name="client_id"/>
                <field name="registered_on"/>
                <field name="active"/>
            </list>
        </field>
    </record>
    <record id="view_axsync_mcp_client_form" model="ir.ui.view">
        <field name="name">axsync.mcp.client.form</field>
        <field name="model">axsync.mcp.client</field>
        <field name="arch" type="xml">
            <form string="OAuth client" create="false">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="client_id"/>
                        <field name="registered_on"/>
                        <field name="active"/>
                    </group>
                    <group string="Redirect addresses"><field name="redirect_uris" nolabel="1"/></group>
                    <group string="Connections"><field name="token_ids" nolabel="1" readonly="1"/></group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_axsync_mcp_client" model="ir.actions.act_window">
        <field name="name">OAuth clients</field>
        <field name="res_model">axsync.mcp.client</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
