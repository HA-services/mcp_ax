<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_axsync_mcp_policy_list" model="ir.ui.view">
        <field name="name">axsync.mcp.policy.list</field>
        <field name="model">axsync.mcp.policy</field>
        <field name="arch" type="xml">
            <tree string="Policies" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="operation"/>
                <field name="tool_ids" widget="many2many_tags"/>
                <field name="model_ids" widget="many2many_tags"/>
                <field name="min_records"/>
                <field name="action" widget="badge" decoration-success="action == 'allow'" decoration-info="action == 'ask'" decoration-warning="action == 'approve'" decoration-danger="action == 'block'"/>
                <field name="active" widget="boolean_toggle"/>
            </tree>
        </field>
    </record>
    <record id="view_axsync_mcp_policy_form" model="ir.ui.view">
        <field name="name">axsync.mcp.policy.form</field>
        <field name="model">axsync.mcp.policy</field>
        <field name="arch" type="xml">
            <form string="Policy">
                <sheet>
                    <group>
                        <group string="When">
                            <field name="name"/>
                            <field name="operation"/>
                            <field name="tool_ids" widget="many2many_tags"/>
                            <field name="model_ids" widget="many2many_tags"/>
                            <field name="user_ids" widget="many2many_tags"/>
                            <field name="group_ids" widget="many2many_tags"/>
                            <field name="domain" placeholder="[('amount_total', '>', 10000)]"/>
                            <field name="min_records"/>
                        </group>
                        <group string="Then">
                            <field name="action"/>
                            <field name="message"/>
                            <field name="sequence"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <group string="Notes"><field name="note" nolabel="1"/></group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_axsync_mcp_policy" model="ir.actions.act_window">
        <field name="name">Policies</field>
        <field name="res_model">axsync.mcp.policy</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
