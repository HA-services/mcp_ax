<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_axsync_mcp_log_list" model="ir.ui.view">
        <field name="name">axsync.mcp.log.list</field>
        <field name="model">axsync.mcp.log</field>
        <field name="arch" type="xml">
            <list string="Audit log" create="false" edit="false" delete="false"
                  decoration-danger="status in ('error', 'denied')" decoration-warning="status == 'pending'">
                <field name="create_date"/>
                <field name="user_id"/>
                <field name="client_name"/>
                <field name="method"/>
                <field name="tool"/>
                <field name="model"/>
                <field name="operation"/>
                <field name="record_count"/>
                <field name="status" widget="badge" decoration-success="status == 'ok'" decoration-danger="status in ('error', 'denied')" decoration-warning="status == 'pending'" decoration-info="status == 'dry_run'"/>
                <field name="duration_ms"/>
            </list>
        </field>
    </record>
    <record id="view_axsync_mcp_log_form" model="ir.ui.view">
        <field name="name">axsync.mcp.log.form</field>
        <field name="model">axsync.mcp.log</field>
        <field name="arch" type="xml">
            <form string="Audit entry" create="false" edit="false" delete="false">
                <sheet>
                    <group>
                        <group>
                            <field name="create_date"/>
                            <field name="user_id"/>
                            <field name="token_id"/>
                            <field name="client_name"/>
                            <field name="ip"/>
                        </group>
                        <group>
                            <field name="method"/>
                            <field name="tool"/>
                            <field name="model"/>
                            <field name="operation"/>
                            <field name="record_count"/>
                            <field name="status"/>
                            <field name="duration_ms"/>
                        </group>
                    </group>
                    <group string="Message"><field name="message" nolabel="1"/></group>
                    <group string="Arguments"><field name="arguments" nolabel="1"/></group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_axsync_mcp_log_search" model="ir.ui.view">
        <field name="name">axsync.mcp.log.search</field>
        <field name="model">axsync.mcp.log</field>
        <field name="arch" type="xml">
            <search>
                <field name="tool"/>
                <field name="model"/>
                <field name="user_id"/>
                <field name="message"/>
                <filter name="writes" string="Writes" domain="[('is_write', '=', True)]"/>
                <filter name="refused" string="Refused or failed" domain="[('status', 'in', ('denied', 'error'))]"/>
                <filter name="today" string="Today" domain="[('day', '=', context_today().strftime('%Y-%m-%d'))]"/>
                
                    <filter name="by_user" string="User" context="{'group_by': 'user_id'}"/>
                    <filter name="by_tool" string="Tool" context="{'group_by': 'tool'}"/>
                    <filter name="by_status" string="Status" context="{'group_by': 'status'}"/>
                    <filter name="by_day" string="Day" context="{'group_by': 'day'}"/>
                
            </search>
        </field>
    </record>
    <record id="view_axsync_mcp_log_pivot" model="ir.ui.view">
        <field name="name">axsync.mcp.log.pivot</field>
        <field name="model">axsync.mcp.log</field>
        <field name="arch" type="xml">
            <pivot string="Usage">
                <field name="tool" type="row"/>
                <field name="status" type="col"/>
                <field name="duration_ms" type="measure"/>
            </pivot>
        </field>
    </record>
    <record id="view_axsync_mcp_log_graph" model="ir.ui.view">
        <field name="name">axsync.mcp.log.graph</field>
        <field name="model">axsync.mcp.log</field>
        <field name="arch" type="xml">
            <graph string="Calls per day" type="bar">
                <field name="day" interval="day"/>
                <field name="status"/>
            </graph>
        </field>
    </record>
    <record id="action_axsync_mcp_log" model="ir.actions.act_window">
        <field name="name">Audit log</field>
        <field name="res_model">axsync.mcp.log</field>
        <field name="view_mode">list,graph,pivot,form</field>
    </record>
</odoo>
