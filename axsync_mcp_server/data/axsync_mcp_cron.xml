<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="cron_axsync_mcp_jobs" model="ir.cron">
            <field name="name">MCP: run bulk jobs</field>
            <field name="model_id" ref="model_axsync_mcp_job"/>
            <field name="state">code</field>
            <field name="code">model._cron_run()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">minutes</field>
        </record>
        <record id="cron_axsync_mcp_approvals" model="ir.cron">
