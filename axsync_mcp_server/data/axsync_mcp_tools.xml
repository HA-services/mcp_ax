<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="tool_whoami" model="axsync.mcp.tool">
            <field name="name">Who am I</field>
            <field name="code">whoami</field>
            <field name="kind">read</field>
            <field name="sequence">1</field>
            <field name="description">Show the Odoo user, company, access level, limits and server version this connection uses. Call this first.</field>
        </record>
        <record id="tool_list_models" model="axsync.mcp.tool">
            <field name="name">List models</field>
            <field name="code">list_models</field>
            <field name="kind">read</field>
            <field name="sequence">2</field>
            <field name="description">List the models the user can read, optionally filtered by a text query on name or technical name.</field>
        </record>
        <record id="tool_describe_model" model="axsync.mcp.tool">
            <field name="name">Describe a model</field>
            <field name="code">describe_model</field>
            <field name="kind">read</field>
            <field name="sequence">3</field>
            <field name="description">Return the fields of a model with type, label, required flag, relation, selection values and whether the field is masked, plus the operations this connection may run on it.</field>
        </record>
        <record id="tool_search_records" model="axsync.mcp.tool">
            <field name="name">Search records</field>
            <field name="code">search_records</field>
            <field name="kind">read</field>
            <field name="sequence">4</field>
            <field name="description">Search and read records of a model. Returns at most the configured maximum per call; use offset to page.</field>
        </record>
        <record id="tool_count_records" model="axsync.mcp.tool">
            <field name="name">Count records</field>
            <field name="code">count_records</field>
            <field name="kind">read</field>
            <field name="sequence">5</field>
            <field name="description">Count the records matching a domain.</field>
        </record>
        <record id="tool_read_records" model="axsync.mcp.tool">
            <field name="name">Read records by id</field>
            <field name="code">read_records</field>
            <field name="kind">read</field>
            <field name="sequence">6</field>
            <field name="description">Read specific records by id.</field>
        </record>
        <record id="tool_aggregate" model="axsync.mcp.tool">
            <field name="name">Aggregate and group</field>
            <field name="code">aggregate</field>
            <field name="kind">read</field>
            <field name="sequence">7</field>
            <field name="description">Group records and compute totals, for example group_by ["partner_id"] with measures ["amount_total:sum"]. Date fields accept a granularity: "date_order:month".</field>
        </record>
        <record id="tool_name_search" model="axsync.mcp.tool">
            <field name="name">Find by name</field>
            <field name="code">name_search</field>
            <field name="kind">read</field>
            <field name="sequence">8</field>
            <field name="description">Find records by display name, the way an Odoo many2one field does.</field>
        </record>
        <record id="tool_export_records" model="axsync.mcp.tool">
            <field name="name">Export to CSV</field>
            <field name="code">export_records</field>
            <field name="kind">read</field>
            <field name="sequence">9</field>
            <field name="description">Export up to 10000 records to a CSV file and return a download link. Masks apply.</field>
        </record>
        <record id="tool_create_records" model="axsync.mcp.tool">
            <field name="name">Create records</field>
            <field name="code">create_records</field>
            <field name="kind">write</field>
            <field name="sequence">20</field>
            <field name="description">Create one or more records. Every record is written to the change journal and can be undone.</field>
        </record>
        <record id="tool_update_records" model="axsync.mcp.tool">
            <field name="name">Update records</field>
            <field name="code">update_records</field>
            <field name="kind">write</field>
            <field name="sequence">21</field>
            <field name="description">Update records selected by ids or by a domain. Old and new values are journaled so the change can be undone.</field>
        </record>
        <record id="tool_delete_records" model="axsync.mcp.tool">
            <field name="name">Delete records</field>
            <field name="code">delete_records</field>
            <field name="kind">write</field>
            <field name="sequence">22</field>
            <field name="description">Delete records. Records with an active flag are archived (and can be restored with undo_change). Others are removed only when they are in a draft or cancelled state. Posted or confirmed documents are refused.</field>
        </record>
        <record id="tool_call_method" model="axsync.mcp.tool">
            <field name="name">Call a method</field>
            <field name="code">call_method</field>
            <field name="kind">write</field>
            <field name="sequence">23</field>
            <field name="description">Call a public method on records, for example action_confirm on sale.order. Private methods and generic write, create and unlink are refused. Methods cannot be rolled back, so there is no dry run and the default policy asks for confirmation.</field>
        </record>
        <record id="tool_undo_change" model="axsync.mcp.tool">
            <field name="name">Undo a change</field>
            <field name="code">undo_change</field>
            <field name="kind">write</field>
            <field name="sequence">24</field>
            <field name="description">Undo a journaled change by journal id or by batch id. Refused when the record changed since.</field>
        </record>
        <record id="tool_list_changes" model="axsync.mcp.tool">
            <field name="name">List journaled changes</field>
            <field name="code">list_changes</field>
            <field name="kind">read</field>
            <field name="sequence">25</field>
            <field name="description">List recent changes made through MCP by this user, newest first.</field>
        </record>
        <record id="tool_approval_status" model="axsync.mcp.tool">
            <field name="name">Approval status</field>
            <field name="code">approval_status</field>
            <field name="kind">read</field>
            <field name="sequence">26</field>
            <field name="description">Check the state of an approval request raised by a previous call.</field>
        </record>
        <record id="tool_list_approvals" model="axsync.mcp.tool">
            <field name="name">List approvals</field>
            <field name="code">list_approvals</field>
            <field name="kind">read</field>
            <field name="sequence">27</field>
            <field name="description">List this user's approval requests.</field>
        </record>
        <record id="tool_start_bulk_job" model="axsync.mcp.tool">
            <field name="name">Start a bulk job</field>
            <field name="code">start_bulk_job</field>
            <field name="kind">write</field>
            <field name="sequence">30</field>
            <field name="description">Update or archive many records in batches in the background. The record set is fixed when the job starts. Use job_status to follow it.</field>
        </record>
        <record id="tool_job_status" model="axsync.mcp.tool">
            <field name="name">Bulk job status</field>
            <field name="code">job_status</field>
            <field name="kind">read</field>
            <field name="sequence">31</field>
            <field name="description">Progress of a bulk job.</field>
        </record>
        <record id="tool_publish_page" model="axsync.mcp.tool">
            <field name="name">Publish a live page</field>
            <field name="code">publish_page</field>
            <field name="kind">write</field>
            <field name="sequence">40</field>
            <field name="description">Publish a read-only live page (table with optional bar chart) built from a query. Modes: private (owner only), login (any signed in user, shown with their own rights) and link (anyone with the link, always needs an approval).</field>
        </record>
        <record id="tool_list_pages" model="axsync.mcp.tool">
            <field name="name">List live pages</field>
            <field name="code">list_pages</field>
            <field name="kind">read</field>
            <field name="sequence">41</field>
            <field name="description">List the live pages published by this user.</field>
        </record>
        <record id="tool_unpublish_page" model="axsync.mcp.tool">
            <field name="name">Unpublish a page</field>
            <field name="code">unpublish_page</field>
            <field name="kind">write</field>
            <field name="sequence">42</field>
            <field name="description">Take a live page offline.</field>
        </record>
        <record id="tool_build_module" model="axsync.mcp.tool">
            <field name="name">Build an Odoo module</field>
            <field name="code">build_module</field>
            <field name="kind">admin</field>
            <field name="sequence">50</field>
            <field name="description">Generate a small installable Odoo module (models, fields, list and form views, menu, access rights) from a specification and return a ZIP download link. Nothing is installed on this server. Models must be named like x_something or vendor.thing.</field>
        </record>
    </data>
</odoo>
